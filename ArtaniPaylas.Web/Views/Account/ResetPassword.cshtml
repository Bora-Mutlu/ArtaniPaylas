@model ArtaniPaylas.Core.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<section class="ap-auth-wrap">
    <div class="container py-4 py-lg-5">
        <div class="ap-auth-shell mx-auto">
            <div class="ap-auth-card p-4 p-md-5 w-100">
                <header class="ap-auth-header mb-4">
                    <span class="ap-auth-eyebrow text-primary fw-bold">Hesap Güvenliği</span>
                    <h1 class="ap-auth-title h2 mb-2">Yeni Şifre Belirle</h1>
                    <p class="text-muted mb-0">Yeni şifrenizi girip hesabınızı güncelleyebilirsiniz.</p>
                </header>

                <form method="post" asp-action="ResetPassword" asp-controller="Account" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <input asp-for="Email" type="hidden" />
                    <input asp-for="Token" type="hidden" />

                    <div class="ap-field mb-3">
                        <label asp-for="Password" class="ap-field-label fw-bold small text-secondary">Yeni Şifre</label>
                        <input asp-for="Password" type="password" class="form-control py-2" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="ap-field mb-4">
                        <label asp-for="ConfirmPassword" class="ap-field-label fw-bold small text-secondary">Yeni Şifre Tekrar</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control py-2" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase">Şifreyi Güncelle</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

