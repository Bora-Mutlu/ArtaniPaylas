@model ArtaniPaylas.Core.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<section class="ap-auth-wrap">
    <div class="container py-4 py-lg-5">
        <div class="ap-auth-shell mx-auto">
            <div class="ap-auth-card p-4 p-md-5 w-100">
                <header class="ap-auth-header mb-4">
                    <span class="ap-auth-eyebrow text-primary fw-bold">Hesap Kurtarma</span>
                    <h1 class="ap-auth-title h2 mb-2">Şifremi Unuttum</h1>
                    <p class="text-muted mb-0">E-posta adresinizi girin, size şifre sıfırlama bağlantısı gönderelim.</p>
                </header>

                <form method="post" asp-action="ForgotPassword" asp-controller="Account" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="ap-field mb-4">
                        <label asp-for="Email" class="ap-field-label fw-bold small text-secondary">E-posta Adresi</label>
                        <input asp-for="Email" type="email" class="form-control py-2" autocomplete="email" placeholder="ornek@mail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase">Sıfırlama Linki Gönder</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
