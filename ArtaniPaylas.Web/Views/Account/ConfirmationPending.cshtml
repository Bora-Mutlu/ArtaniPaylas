@model dynamic

@{
    ViewData["Title"] = "E-posta Doğrulama Bekleniyor";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow">
                <div class="card-body p-5 text-center">
                    <h1 class="mb-4">
                        <i class="bi bi-envelope-check" style="color: #006948; font-size: 3rem;"></i>
                    </h1>
                    <h2 class="card-title mb-3">E-posta Doğrulaması Bekleniyor</h2>
                    
                    <p class="text-muted mb-4">
                        Doğrulama e-postası <strong>@Model.Email</strong> adresine gönderilmiştir.
                    </p>

                    <div class="alert alert-info mb-4" role="alert">
                        <p class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Lütfen e-posta doğrulaması yapın.</strong> Aksi takdirde talep oluşturamayacaksınız.
                        </p>
                    </div>

                    <div class="alert alert-light border-start border-info mb-4">
                        <strong>E-posta alamıyor musunuz?</strong>
                        <ol class="mt-2 mb-0">
                            <li>Spam klasörünü kontrol edin</li>
                            <li>Aşağıdan yeni bir doğrulama e-postası talep edin</li>
                        </ol>
                    </div>

                    <form method="post" action="@Url.Action("ResendConfirmationEmail", "Account")" class="mb-3">
                        <input type="hidden" name="email" value="@Model.Email" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">
                            <i class="bi bi-arrow-repeat me-2"></i> Doğrulama E-postasını Yeniden Gönder
                        </button>
                    </form>

                    <hr />

                    <p class="text-muted mb-0">
                        <a href="@Url.Action("Login", "Account")">Giriş Yap</a> veya 
                        <a href="@Url.Action("Index", "Home")">Ana Sayfaya Dön</a>
                    </p>
                </div>
            </div>

            <div class="mt-4 p-4 bg-light rounded text-center">
                <p class="text-muted mb-0">
                    <i class="bi bi-shield-check me-2" style="color: #006948;"></i>
                    Hesabınız güvende. Lütfen sakin olun ve adımları izleyin.
                </p>
            </div>
        </div>
    </div>
</div>


