@model IReadOnlyCollection<Request>
@{
    ViewData["Title"] = "İlan Randevuları";
    Layout = "_UserLayout";
}

<section class="ap-page-head">
    <div>
        <h1 class="ap-title">İlanlarıma Gelen Randevular</h1>
        <p class="ap-subtitle">Bu ekran bilgilendirme amaçlıdır. Belediye hesabı randevuları admin panelinden yönetir.</p>
    </div>
</section>

@if (!Model.Any())
{
    <div class="ap-empty">Henüz ilanlarına randevu talebi gelmedi.</div>
}
else
{
    <div class="ap-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0 ap-table">
                <thead>
                    <tr>
                        <th>İlan</th>
                        <th>Kullanıcı</th>
                        <th>Talep Edilen Saat</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Listing?.Title</td>
                        <td>@(item.RequesterUser?.FullName ?? item.RequesterUser?.UserName ?? "Kullanıcı")</td>
                        <td>@item.RequestedAppointmentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.Status.ToDisplayText()</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
