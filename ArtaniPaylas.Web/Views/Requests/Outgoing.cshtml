@model IReadOnlyCollection<Request>
@{
    ViewData["Title"] = "Randevularım";
    Layout = "_UserLayout";
}

<section class="ap-page-head mb-4">
    <div>
        <h1 class="ap-title">Randevu Takip Ekrani</h1>
        <p class="ap-subtitle">Belediyeye gönderdiğiniz randevu taleplerinin güncel durumunu buradan izleyebilirsiniz.</p>
    </div>
</section>

@if (!Model.Any())
{
    <div class="ap-empty">Henüz oluşturulmuş randevu bulunmuyor.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            var statusClass = item.Status switch
            {
                RequestStatus.Pending => "ap-pill ap-pill-pending",
                RequestStatus.Approved => "ap-pill ap-pill-active",
                RequestStatus.Delivered => "ap-pill ap-pill-completed",
                _ => "ap-pill ap-pill-danger"
            };

            <div class="col-lg-6">
                <article class="ap-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">@item.Listing?.Title</h2>
                        <span class="@statusClass">@item.Status.ToDisplayText()</span>
                    </div>
                    <div class="row g-3 text-sm">
                        <div class="col-md-6">
                            <div class="ay-detail-meta">
                                <strong>Talep edilen saat</strong>
                                <div>@item.RequestedAppointmentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ay-detail-meta">
                                <strong>Onaylanan saat</strong>
                                <div>@(item.ConfirmedAppointmentAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="ay-detail-meta">
                                <strong>Not</strong>
                                <div>@(item.MunicipalityNote ?? item.RequesterNote ?? "Not bulunmuyor.")</div>
                            </div>
                        </div>
                    </div>
                    <a asp-controller="Listings" asp-action="Details" asp-route-id="@item.ListingId" class="btn ap-btn-outline mt-3">İlan Detayını Aç</a>
                </article>
            </div>
        }
    </div>
}
