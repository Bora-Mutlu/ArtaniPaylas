@model UserDashboardViewModel
@{
    ViewData["Title"] = "Panelim";
    Layout = "_UserLayout";
}

<div class="mb-10">
    <h2 class="text-4xl font-extrabold ay-brand-text tracking-tight mb-2">Hoş geldiniz, @Model.DisplayName</h2>
    <p class="ay-meta-note text-lg">Belediyenin yayınladığı ilanları inceleyebilir ve uygun olanlar için randevu oluşturabilirsiniz.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="p-6 ay-card-soft data-spotlight transition-all">
        <p class="text-[10px] uppercase font-bold tracking-widest ay-meta-note mb-1">Aktif ilanlar</p>
        <div class="flex items-baseline gap-2">
            <span class="text-4xl font-black ay-brand-text">@Model.ActiveListingsCount</span>
            <span class="text-xs font-bold ay-chip-accent px-2 py-0.5 rounded-full">+@Model.NewListingsLast7Days yeni</span>
        </div>
    </div>

    <div class="p-6 ay-card-soft data-spotlight transition-all">
        <p class="text-[10px] uppercase font-bold tracking-widest ay-meta-note mb-1">Randevularım</p>
        <div class="flex items-baseline gap-2">
            <span class="text-4xl font-black ay-brand-text">@Model.IncomingRequestsCount</span>
            <span class="text-xs font-bold ay-chip-soft px-2 py-0.5 rounded-full">@Model.PendingIncomingRequestsCount bekliyor</span>
        </div>
    </div>

    <div class="p-6 ay-card-tint rounded-xl flex flex-col justify-between relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-[10px] uppercase font-bold tracking-widest text-white/70 mb-1">Onay oranı</p>
            <span class="text-4xl font-black text-white">%@Model.OutgoingSuccessRate.ToString("0.0")</span>
        </div>
        <div class="absolute right-[-10%] top-[-10%] opacity-10 group-hover:scale-110 transition-transform duration-500">
            <span class="material-symbols-outlined text-[140px]" style="font-variation-settings: 'FILL' 1;">event_available</span>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    <div class="lg:col-span-2 flex flex-col gap-6">
        <div class="flex items-center justify-between px-2">
            <h3 class="text-xl font-bold ay-brand-text">Son yayınlanan ilanlar</h3>
            <a class="text-sm font-semibold ay-link hover:underline" href="/Listings">Tüm ilanları gör</a>
        </div>

        <div class="flex flex-col gap-3">
            @if (!Model.RecentListings.Any())
            {
                <div class="ay-card-soft p-6 rounded-xl text-sm ay-meta-note">Henüz yayınlanmış ilan bulunmuyor.</div>
            }
            else
            {
                @foreach (var item in Model.RecentListings)
                {
                    var statusClass = item.StatusText.Contains("Aktif", StringComparison.OrdinalIgnoreCase)
                        ? "ay-chip-soft"
                        : item.StatusText.Contains("Tamam", StringComparison.OrdinalIgnoreCase)
                            ? "bg-slate-200 text-slate-700"
                            : "bg-red-100 text-red-700";

                    <div class="ay-card-soft p-4 rounded-xl flex items-center gap-5 group transition-colors">
                        <div class="h-20 w-20 rounded-lg overflow-hidden flex-shrink-0 bg-slate-100">
                            @if (!string.IsNullOrWhiteSpace(item.PhotoPath))
                            {
                                <img alt="@item.Title" class="h-full w-full object-cover" src="@item.PhotoPath" />
                            }
                            else
                            {
                                <div class="h-full w-full flex items-center justify-center ay-meta-note text-xs">Fotoğraf Yok</div>
                            }
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start mb-1 gap-3">
                                <h4 class="font-bold text-on-surface text-lg truncate">@item.Title</h4>
                                <span class="text-xs font-bold px-3 py-1 rounded-full @statusClass">@item.StatusText</span>
                            </div>
                            <div class="flex gap-4 text-xs font-medium ay-meta-note">
                                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">mail</span> @item.RequestCount başvuru</span>
                                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">schedule</span> @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>

                        <div class="flex flex-col items-end gap-2">
                            <a href="/Listings/Details/@item.Id" class="p-2 ay-icon-soft rounded-lg transition-all">
                                <span class="material-symbols-outlined">visibility</span>
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="lg:col-span-1 flex flex-col gap-8">
        <div class="ay-card-soft p-6 rounded-xl">
            <h3 class="text-sm font-extrabold uppercase tracking-widest ay-brand-text mb-6">Hızlı işlemler</h3>
            <div class="grid grid-cols-2 gap-3">
                <a href="/Listings" class="flex flex-col items-center justify-center p-4 ay-card-soft rounded-xl ay-hover-brand group transition-all no-underline">
                    <span class="material-symbols-outlined ay-brand-text group-hover:text-white mb-2">view_list</span>
                    <span class="text-[11px] font-bold group-hover:text-white uppercase">İlanlar</span>
                </a>
                <a href="/Requests/Outgoing" class="flex flex-col items-center justify-center p-4 ay-card-soft rounded-xl ay-hover-brand group transition-all no-underline">
                    <span class="material-symbols-outlined ay-brand-text group-hover:text-white mb-2">event</span>
                    <span class="text-[11px] font-bold group-hover:text-white uppercase">Randevularım</span>
                </a>
                <a href="/Profile" class="flex flex-col items-center justify-center p-4 ay-card-soft rounded-xl ay-hover-brand group transition-all no-underline">
                    <span class="material-symbols-outlined ay-brand-text group-hover:text-white mb-2">person</span>
                    <span class="text-[11px] font-bold group-hover:text-white uppercase">Profil</span>
                </a>
            </div>
        </div>

        <div class="ay-card-soft p-6 rounded-xl border-t-4" style="border-color:var(--up-accent);">
            <h3 class="text-lg font-bold text-on-surface mb-6 flex items-center justify-between">
                Bekleyen randevularım
                <span class="h-6 min-w-6 px-2 ay-chip-accent text-[10px] flex items-center justify-center rounded-full">@Model.PendingIncomingRequestsCount</span>
            </h3>
            <div class="flex flex-col gap-4">
                @if (!Model.PendingIncomingRequests.Any())
                {
                    <div class="text-sm ay-meta-note">Bekleyen randevu bulunmuyor.</div>
                }
                else
                {
                    @foreach (var request in Model.PendingIncomingRequests)
                    {
                        var ago = DateTime.Now - request.CreatedAt.ToLocalTime();
                        var agoText = ago.TotalHours < 1
                            ? $"{Math.Max(1, (int)ago.TotalMinutes)} dk önce"
                            : ago.TotalDays < 1
                                ? $"{(int)ago.TotalHours} saat önce"
                                : $"{(int)ago.TotalDays} gün önce";

                        <a href="/Requests/Outgoing" class="flex gap-4 p-3 rounded-lg ay-card-soft transition-colors cursor-pointer no-underline">
                            <div class="h-10 w-10 rounded-full ay-icon-soft flex items-center justify-center font-black text-xs flex-shrink-0">@request.RequesterInitials</div>
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-on-surface truncate">@request.RequesterName</p>
                                <p class="text-[11px] ay-meta-note truncate">@request.ListingTitle için oluşturuldu.</p>
                                <p class="text-[10px] ay-accent-text mt-1 font-bold">@agoText</p>
                            </div>
                        </a>
                    }
                }
            </div>
            <a href="/Requests/Outgoing" class="w-full mt-6 py-3 border rounded-xl text-xs font-bold uppercase tracking-wider ay-link transition-all inline-flex justify-center no-underline" style="border-color:var(--up-border);">
                Tüm randevularımı gör
            </a>
        </div>

        <div class="ay-card-soft p-6 rounded-xl">
            <h3 class="text-sm font-extrabold uppercase tracking-widest ay-brand-text mb-4">Yeni ilan bildirimi</h3>
            <form asp-action="UpdateNewListingEmailPreference" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="enabled" value="@(Model.NotifyOnNewListingsByEmail ? "false" : "true")" />
                <p class="text-sm ay-meta-note mb-0">Belediye yeni ilan yayınladığında e-posta almak için bu tercihi kullanabilirsin.</p>
                @if (Model.NotifyOnNewListingsByEmail)
                {
                    <button type="submit" class="w-full bg-slate-200 text-on-surface py-2.5 rounded-xl text-sm font-bold hover:opacity-90 transition-opacity">E-posta Bildirimini Kapat</button>
                }
                else
                {
                    <button type="submit" class="w-full ap-btn-primary py-2.5 rounded-xl text-sm font-bold hover:opacity-90 transition-opacity">E-posta Bildirimini Aç</button>
                }
            </form>
        </div>
    </div>
</div>
