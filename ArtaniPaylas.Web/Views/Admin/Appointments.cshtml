@model IReadOnlyCollection<Request>
@{
    ViewData["Title"] = "Randevu Yönetimi";
    Layout = "_AdminLayout";

    var selectedStatus = ViewBag.SelectedStatus as RequestStatus?;
    var search = ViewBag.Search as string ?? string.Empty;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
}

<section class="mb-6">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">Randevu masası</div>
            <h1 class="font-headline text-3xl font-bold tracking-tight text-on-surface">Kullanıcı randevu talepleri</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-600">Uygun saat belirleyin, açıklama ekleyin ve kullanıcıya net dönüş yapın.</p>
        </div>
        <a href="/Admin" class="inline-flex items-center justify-center rounded-lg bg-white px-4 py-2 text-sm font-bold text-slate-700 no-underline shadow-sm ring-1 ring-black/5 hover:bg-slate-50">Panele Dön</a>
    </div>
</section>

<section class="mb-5 rounded-xl bg-white/85 p-4 shadow-sm ring-1 ring-black/5">
    <form asp-action="Appointments" method="get" class="grid gap-3 lg:grid-cols-[1fr_220px_auto] lg:items-end">
        <label class="block">
            <span class="mb-1 block text-xs font-bold text-slate-600">Arama</span>
            <input name="search" value="@search" class="w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm" placeholder="İlan, kullanıcı veya e-posta ara" />
        </label>
        <label class="block">
            <span class="mb-1 block text-xs font-bold text-slate-600">Durum</span>
            <select name="status" class="w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm">
                <option value="">Tüm durumlar</option>
                @foreach (RequestStatus status in Enum.GetValues<RequestStatus>())
                {
                    <option value="@status" selected="@(selectedStatus == status)">@status.ToDisplayText()</option>
                }
            </select>
        </label>
        <div class="flex gap-2">
            <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-bold text-on-primary hover:opacity-90">Filtrele</button>
            <a asp-action="Appointments" class="inline-flex min-h-10 items-center justify-center rounded-lg bg-slate-100 px-4 py-2 text-sm font-bold text-slate-700 no-underline hover:bg-slate-200">Temizle</a>
        </div>
    </form>
</section>

@if (!Model.Any())
{
    <section class="rounded-xl bg-white/85 p-8 text-center shadow-sm ring-1 ring-black/5">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
            <span class="material-symbols-outlined">event_busy</span>
        </div>
        <h2 class="text-lg font-bold text-on-surface">Randevu bulunamadı</h2>
        <p class="mt-1 text-sm text-slate-600">Seçili filtrelere uygun randevu kaydı yok.</p>
    </section>
}
else
{
    <section class="space-y-4">
        <div class="text-sm font-semibold text-slate-600">@totalCount kayıt içinden @Model.Count kayıt gösteriliyor.</div>
        @foreach (var item in Model)
        {
            var requesterName = item.RequesterUser?.FullName ?? item.RequesterUser?.UserName ?? "Kullanıcı";
            var requesterEmail = item.RequesterUser?.Email ?? "-";
            var requesterPhone = item.RequesterUser?.PhoneNumber ?? "-";
            var ownerName = item.Listing?.OwnerUser?.FullName ?? item.Listing?.OwnerUser?.UserName ?? "İlan sahibi";
            var ownerEmail = item.Listing?.OwnerUser?.Email ?? "-";
            var canApprove = item.Status == RequestStatus.Pending;
            var canReject = item.Status == RequestStatus.Pending;
            var canDeliver = item.Status == RequestStatus.Approved;
            var statusClass = item.Status switch
            {
                RequestStatus.Pending => "bg-amber-100 text-amber-900",
                RequestStatus.Approved => "bg-emerald-100 text-emerald-900",
                RequestStatus.Delivered => "bg-blue-100 text-blue-900",
                _ => "bg-rose-100 text-rose-900"
            };

            <article class="rounded-xl bg-white/90 p-4 shadow-sm ring-1 ring-black/5 md:p-5">
                <div class="grid gap-5 xl:grid-cols-[1.2fr_0.8fr]">
                    <div class="min-w-0">
                        <div class="mb-4 flex flex-wrap items-center gap-2">
                            <h2 class="min-w-0 text-xl font-extrabold text-on-surface">@(!string.IsNullOrWhiteSpace(item.Listing?.Title) ? item.Listing.Title : "İlan silinmiş")</h2>
                            <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold @statusClass">@item.Status.ToDisplayText()</span>
                            @if (item.Listing is not null)
                            {
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@item.ListingId" class="text-sm font-bold text-primary no-underline hover:underline">İlanı aç</a>
                            }
                        </div>

                        <div class="grid gap-3 md:grid-cols-2">
                            <div class="rounded-lg bg-slate-50 p-3">
                                <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Talep eden</div>
                                <div class="mt-1 font-bold text-on-surface">@requesterName</div>
                                <div class="break-all text-sm text-slate-600">@requesterEmail</div>
                                <div class="text-sm text-slate-600">@requesterPhone</div>
                            </div>
                            <div class="rounded-lg bg-slate-50 p-3">
                                <div class="text-xs font-bold uppercase tracking-wide text-slate-500">İlan sahibi</div>
                                <div class="mt-1 font-bold text-on-surface">@ownerName</div>
                                <div class="break-all text-sm text-slate-600">@ownerEmail</div>
                                <div class="text-sm text-slate-600">İlan durumu: @(item.Listing?.Status.ToDisplayText() ?? "-")</div>
                            </div>
                            <div class="rounded-lg bg-slate-50 p-3">
                                <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Talep edilen saat</div>
                                <div class="mt-1 font-bold text-on-surface">@item.RequestedAppointmentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <div class="rounded-lg bg-slate-50 p-3">
                                <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Onaylanan saat</div>
                                <div class="mt-1 font-bold text-on-surface">@(item.ConfirmedAppointmentAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                            </div>
                            <div class="rounded-lg bg-slate-50 p-3 md:col-span-2">
                                <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Kullanıcı notu</div>
                                <div class="mt-1 whitespace-pre-wrap text-sm text-slate-700">@(item.RequesterNote ?? "Not yok")</div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded-lg bg-slate-50 p-4">
                        @if (canApprove || canReject || canDeliver)
                        {
                            <form asp-action="UpdateAppointment" method="post" class="space-y-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <label class="block">
                                    <span class="mb-1 block text-xs font-bold text-slate-600">Onaylanacak saat</span>
                                    <input name="confirmedAppointmentAt" type="datetime-local" class="w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm" value="@(item.ConfirmedAppointmentAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? item.RequestedAppointmentAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" disabled="@(!canApprove)" />
                                </label>
                                <label class="block">
                                    <span class="mb-1 block text-xs font-bold text-slate-600">Belediye notu</span>
                                    <textarea name="municipalityNote" rows="4" class="w-full resize-none rounded-lg border border-black/10 bg-white px-3 py-2 text-sm">@item.MunicipalityNote</textarea>
                                </label>
                                <div class="flex flex-wrap gap-2">
                                    @if (canApprove)
                                    {
                                        <button type="submit" name="status" value="@RequestStatus.Approved" class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-800">Onayla</button>
                                    }
                                    @if (canReject)
                                    {
                                        <button type="submit" name="status" value="@RequestStatus.Rejected" class="rounded-lg bg-rose-700 px-4 py-2 text-sm font-bold text-white hover:bg-rose-800">Reddet</button>
                                    }
                                    @if (canDeliver)
                                    {
                                        <button type="submit" name="status" value="@RequestStatus.Delivered" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-black">Tamamlandı</button>
                                    }
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-sm text-slate-600">
                                <div class="mb-1 font-bold text-on-surface">İşlem kapalı</div>
                                <p class="mb-3">Bu randevu terminal durumda olduğu için yeniden güncellenemez.</p>
                                <div class="rounded-lg bg-white p-3">
                                    <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Belediye notu</div>
                                    <div class="mt-1 whitespace-pre-wrap">@(item.MunicipalityNote ?? "Not yok")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </section>

    @if (totalPages > 1)
    {
        <nav class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-white/85 p-4 text-sm shadow-sm ring-1 ring-black/5">
            <div class="font-semibold text-slate-600">Sayfa @currentPage / @totalPages</div>
            <div class="flex gap-2">
                @if (currentPage > 1)
                {
                    <a asp-action="Appointments" asp-route-page="@(currentPage - 1)" asp-route-status="@selectedStatus" asp-route-search="@search" class="rounded-lg bg-slate-100 px-4 py-2 font-bold text-slate-700 no-underline hover:bg-slate-200">Önceki</a>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-action="Appointments" asp-route-page="@(currentPage + 1)" asp-route-status="@selectedStatus" asp-route-search="@search" class="rounded-lg bg-slate-100 px-4 py-2 font-bold text-slate-700 no-underline hover:bg-slate-200">Sonraki</a>
                }
            </div>
        </nav>
    }
}
