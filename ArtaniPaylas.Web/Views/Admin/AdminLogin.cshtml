@model ArtaniPaylas.Core.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Belediye Girişi";
    Layout = "_Layout";
}

<section class="ap-auth-wrap">
    <div class="container py-4 py-lg-5">
        <div class="ap-auth-shell mx-auto">
            <aside class="ap-auth-visual text-center" aria-hidden="true">
                <span class="ap-auth-eyebrow text-uppercase fw-bold text-success d-inline-block mb-2">Ayancık Belediyesi</span>
                <h2 class="ap-auth-visual-title h2 text-dark mt-3">Belediye yönetim paneline güvenli giriş.</h2>
                <p class="ap-auth-visual-text text-secondary mt-3 mb-4">İlanları, konteyner haritasını ve randevu yönetimini tek panelden yönetin.</p>
            </aside>

            <div class="ap-auth-card p-4 p-md-5">
                <header class="ap-auth-header mb-4">
                    <span class="ap-auth-eyebrow text-primary fw-bold">Yetkili Oturumu</span>
                    <h1 class="ap-auth-title h2 mb-2">Belediye Girişi</h1>
                    <p class="text-muted mb-0">Yalnızca yetkili belediye hesabı ile devam edebilirsiniz.</p>
                </header>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger p-2 mb-4" role="alert">
                        <div asp-validation-summary="All" class="mb-0 list-unstyled" style="font-size: 0.9rem;"></div>
                    </div>
                }

                <form action="/Admin/Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-posta Adresi</label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="belediye@ayancik.bel.tr" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input asp-for="Password" class="form-control form-control-lg" />
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Bu cihazda hatırla</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3 fw-bold">Giriş Yap</button>

                    <div class="text-center mt-4">
                        <a href="/" class="text-decoration-none text-muted">Ana sayfaya dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
