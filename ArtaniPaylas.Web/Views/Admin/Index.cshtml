@{
    ViewData["Title"] = "Belediye Paneli";
    Layout = "_AdminLayout";
    var recentActivities = (ViewBag.RecentActivities as IEnumerable<string> ?? Enumerable.Empty<string>()).ToList();
}

<section class="mb-5">
    <div class="rounded-[32px] bg-white/85 border border-black/5 p-5 p-lg-6 shadow-sm">
        <div class="text-[11px] uppercase tracking-[0.24em] text-slate-500 mb-2">Operasyon özeti</div>
        <h1 class="font-headline text-4xl font-bold tracking-tight mb-2">Ayancık Belediyesi kıyafet operasyon merkezi</h1>
        <p class="text-slate-600 mb-0">İlanlar, konteyner noktalarının harita yönetimi ve kullanıcı randevuları aynı ekranda toplanır.</p>
    </div>
</section>

<section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-5">
    <div class="rounded-[28px] bg-white/80 border border-black/5 p-5">
        <div class="small text-muted">Aktif konteyner</div>
        <div class="font-headline text-4xl font-bold">@ViewBag.ActiveContainers</div>
        <div class="text-sm text-slate-500">Toplam @ViewBag.TotalContainers kayıt</div>
    </div>
    <div class="rounded-[28px] bg-white/80 border border-black/5 p-5">
        <div class="small text-muted">Bekleyen randevu</div>
        <div class="font-headline text-4xl font-bold">@ViewBag.PendingAppointments</div>
        <div class="text-sm text-slate-500">@ViewBag.ApprovedAppointments onaylı talep</div>
    </div>
    <div class="rounded-[28px] bg-white/80 border border-black/5 p-5">
        <div class="small text-muted">Aktif ilan</div>
        <div class="font-headline text-4xl font-bold">@ViewBag.ActiveListings</div>
        <div class="text-sm text-slate-500">Toplam @ViewBag.TotalListings ilan</div>
    </div>
    <div class="rounded-[28px] bg-white/80 border border-black/5 p-5">
        <div class="small text-muted">Bekleyen şikayet</div>
        <div class="font-headline text-4xl font-bold">@ViewBag.PendingReports</div>
        <div class="text-sm text-slate-500">@ViewBag.ResolvedReports çözülmüş kayıt</div>
    </div>
</section>

<section class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
    <a href="/Admin/Containers" class="rounded-[28px] bg-white/80 border border-black/5 p-5 no-underline text-inherit">
        <div class="h-14 w-14 rounded-3xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-4xl">map</span>
        </div>
        <h2 class="font-headline text-2xl font-bold mb-2">Harita ve konteynerler</h2>
        <p class="text-slate-600 mb-0">Konteyner noktalarını harita üzerinden seçin, ekleyin ve aktifliklerini yönetin.</p>
    </a>
    <a href="/Admin/Appointments" class="rounded-[28px] bg-white/80 border border-black/5 p-5 no-underline text-inherit">
        <div class="h-14 w-14 rounded-3xl bg-sky-100 text-sky-700 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-4xl">event_available</span>
        </div>
        <h2 class="font-headline text-2xl font-bold mb-2">Randevu masası</h2>
        <p class="text-slate-600 mb-0">Kullanıcı taleplerini uygun saatlere göre onaylayın, reddedin veya tamamlayın.</p>
    </a>
    <a href="/Admin/Listings" class="rounded-[28px] bg-white/80 border border-black/5 p-5 no-underline text-inherit">
        <div class="h-14 w-14 rounded-3xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-4xl">styler</span>
        </div>
        <h2 class="font-headline text-2xl font-bold mb-2">İlan kurulumu</h2>
        <p class="text-slate-600 mb-0">Belediye tarafından yayınlanacak kıyafet ilanlarını oluşturun ve güncelleyin.</p>
    </a>
</section>

<section class="rounded-[32px] bg-white/85 border border-black/5 p-5 p-lg-6">
    <h2 class="font-headline text-2xl font-bold mb-4">Son hareketler</h2>
    @if (recentActivities.Count == 0)
    {
        <div class="text-muted">Henüz aktivite bulunmuyor.</div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            @foreach (var activity in recentActivities)
            {
                <div class="rounded-4 bg-slate-50 border border-black/5 px-4 py-3">@activity</div>
            }
        </div>
    }
</section>
