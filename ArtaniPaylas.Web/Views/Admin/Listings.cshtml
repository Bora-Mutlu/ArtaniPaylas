@model IEnumerable<ArtaniPaylas.Core.Entities.Listing>
@{
    ViewData["Title"] = "İlan Yönetimi";
    Layout = "_AdminLayout";

    var listings = Model.ToList();
    var categories = ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>();
    var selectedCategory = ViewBag.Category as string;
    var selectedStatus = ViewBag.Status as ListingStatus?;
    var createdDate = ViewBag.CreatedDate as DateTime?;
    var search = ViewBag.Search as string;
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? listings.Count);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var firstResult = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    var lastResult = Math.Min(page * pageSize, totalCount);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string StatusBadgeClass(ListingStatus status) => status switch
    {
        ListingStatus.Active => "bg-[#d4f8e8] text-[#004c38]",
        ListingStatus.Suspended => "bg-[#ffdad6] text-[#93000a]",
        ListingStatus.Completed => "bg-[#e1f0ff] text-[#124a73]",
        ListingStatus.Expired => "bg-[#e4e2dd] text-[#3f4944]",
        ListingStatus.Canceled => "bg-[#f3d8d2] text-[#76332c]",
        _ => "bg-[#e4e2dd] text-[#3f4944]"
    };
}

<style>
    .ap-listings-page {
        --ay-primary: #00523d;
        --ay-primary-container: #0d6c52;
        --ay-secondary: #006c4b;
        --ay-surface: #fbf9f3;
        --ay-surface-low: #f5f3ed;
        --ay-surface-container: #f0eee8;
        --ay-surface-high: #e4e2dd;
        --ay-outline: #bec9c2;
        --ay-text: #1b1c18;
        --ay-muted: #3f4944;
    }

    .ap-listings-page .glass-card {
        background: rgba(255, 255, 255, .72);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, .48);
        box-shadow: 0 10px 30px rgba(13, 108, 82, .06);
    }

    .ap-listings-page input,
    .ap-listings-page select {
        color: var(--ay-text);
    }
</style>

<div class="ap-listings-page text-[#1b1c18]">
    <nav class="flex items-center gap-1 text-[#3f4944] text-sm font-bold mb-3">
        <a class="hover:text-[#00523d] transition-colors no-underline" href="/Admin">Panel</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-[#00523d]">İlan Yönetimi</span>
    </nav>

    <header class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="font-headline text-3xl md:text-4xl font-bold tracking-tight text-[#1b1c18] mb-2">İlan Moderasyonu</h1>
            <p class="text-base text-[#3f4944] max-w-3xl">Sistemdeki kıyafet bağış ve talep ilanlarını buradan inceleyebilir, onaylayabilir veya yönetebilirsiniz.</p>
        </div>
        <a href="/Listings/Create" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#00523d] px-5 py-3 text-sm font-bold text-white no-underline shadow-[0_10px_24px_rgba(0,82,61,.18)] transition hover:bg-[#0d6c52] active:scale-95">
            <span class="material-symbols-outlined text-[20px]">add</span>
            İlan Oluştur
        </a>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
        <div class="glass-card p-6 rounded-3xl">
            <div class="flex items-center justify-between mb-3">
                <span class="material-symbols-outlined bg-[#00523d]/10 text-[#00523d] p-2 rounded-lg">inventory_2</span>
            </div>
            <p class="text-[#3f4944] text-sm font-bold">Toplam İlan</p>
            <h2 class="font-headline text-4xl md:text-5xl font-bold text-[#00523d]">@ViewBag.TotalListings</h2>
        </div>
        <div class="glass-card p-6 rounded-3xl border-l-4 border-[#00523d]">
            <div class="flex items-center justify-between mb-3">
                <span class="material-symbols-outlined bg-[#006c4b]/10 text-[#006c4b] p-2 rounded-lg">check_circle</span>
            </div>
            <p class="text-[#3f4944] text-sm font-bold">Aktif</p>
            <h2 class="font-headline text-4xl md:text-5xl font-bold text-[#006c4b]">@ViewBag.ActiveListings</h2>
        </div>
        <div class="glass-card p-6 rounded-3xl border-l-4 border-[#ba1a1a]">
            <div class="flex items-center justify-between mb-3">
                <span class="material-symbols-outlined bg-[#ba1a1a]/10 text-[#ba1a1a] p-2 rounded-lg">pause_circle</span>
            </div>
            <p class="text-[#3f4944] text-sm font-bold">Askıda</p>
            <h2 class="font-headline text-4xl md:text-5xl font-bold text-[#ba1a1a]">@ViewBag.SuspendedListings</h2>
        </div>
        <div class="glass-card p-6 rounded-3xl bg-[#0d6c52] text-[#98eac9]">
            <div class="flex items-center justify-between mb-3">
                <span class="material-symbols-outlined bg-white/20 p-2 rounded-lg">new_releases</span>
            </div>
            <p class="text-sm font-bold opacity-90">Bugün Yeni</p>
            <h2 class="font-headline text-4xl md:text-5xl font-bold">@ViewBag.TodayListings</h2>
        </div>
    </section>

    <form method="get" action="/Admin/Listings" class="glass-card p-3 rounded-2xl mb-6 flex flex-wrap items-center gap-3">
        <div class="flex-1 min-w-[220px]">
            <div class="relative">
                <input name="search" value="@search" class="w-full bg-white border border-[#bec9c2]/60 rounded-xl px-4 py-3 pl-10 focus:ring-2 focus:ring-[#00523d] focus:border-[#00523d] outline-none" placeholder="Başlığa göre ara..." type="text" />
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#3f4944]">search</span>
            </div>
        </div>
        <select name="category" class="bg-white border border-[#bec9c2]/60 rounded-xl px-4 py-3 focus:ring-2 focus:ring-[#00523d] focus:border-[#00523d] outline-none text-sm font-bold">
            <option value="">Tüm Kategoriler</option>
            @foreach (var item in categories)
            {
                if (selectedCategory == item)
                {
                    <option value="@item" selected>@item</option>
                }
                else
                {
                    <option value="@item">@item</option>
                }
            }
        </select>
        <select name="status" class="bg-white border border-[#bec9c2]/60 rounded-xl px-4 py-3 focus:ring-2 focus:ring-[#00523d] focus:border-[#00523d] outline-none text-sm font-bold">
            <option value="">Durum Seç</option>
            @foreach (ListingStatus status in Enum.GetValues(typeof(ListingStatus)))
            {
                if (selectedStatus == status)
                {
                    <option value="@status" selected>@status.ToDisplayText()</option>
                }
                else
                {
                    <option value="@status">@status.ToDisplayText()</option>
                }
            }
        </select>
        <input name="createdDate" value="@(createdDate?.ToString("yyyy-MM-dd"))" class="bg-white border border-[#bec9c2]/60 rounded-xl px-4 py-3 focus:ring-2 focus:ring-[#00523d] focus:border-[#00523d] outline-none text-sm font-bold" type="date" />
        <button class="bg-[#006c4b] text-white px-6 py-3 rounded-xl text-sm font-bold hover:shadow-md transition-all active:scale-95 flex items-center gap-1" type="submit">
            <span class="material-symbols-outlined">filter_list</span>
            Filtrele
        </button>
        <a href="/Admin/Listings" class="bg-[#f0eee8] text-[#1b1c18] px-4 py-3 rounded-xl text-sm font-bold no-underline hover:bg-[#e4e2dd] transition-colors">Temizle</a>
    </form>

    <section class="glass-card rounded-3xl overflow-hidden border border-[#bec9c2]/30">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-[#f0eee8] text-[#1b1c18]">
                        <th class="px-6 py-4 font-bold border-b border-[#bec9c2]/40">No</th>
                        <th class="px-6 py-4 font-bold border-b border-[#bec9c2]/40">Başlık</th>
                        <th class="px-6 py-4 font-bold border-b border-[#bec9c2]/40">Kategori</th>
                        <th class="px-6 py-4 font-bold border-b border-[#bec9c2]/40">Durum</th>
                        <th class="px-6 py-4 font-bold border-b border-[#bec9c2]/40">Tarih</th>
                        <th class="px-6 py-4 font-bold border-b border-[#bec9c2]/40 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#bec9c2]/20">
                    @if (!listings.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-[#3f4944]">
                                <span class="material-symbols-outlined text-4xl mb-2">search_off</span>
                                <div class="font-bold text-[#1b1c18]">İlan bulunamadı</div>
                                <div class="text-sm">Filtreleri değiştirerek tekrar deneyin.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var listing in listings)
                    {
                        var photo = listing.Photos.OrderBy(x => x.SortOrder).FirstOrDefault()?.PhotoPath ?? listing.PhotoPath;
                        <tr class="hover:bg-[#00523d]/5 transition-colors group">
                            <td class="px-6 py-5 text-[#3f4944]">#@listing.Id</td>
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3 min-w-[260px]">
                                    <div class="w-11 h-11 rounded-lg overflow-hidden flex-shrink-0 bg-[#e4e2dd]">
                                        @if (!string.IsNullOrWhiteSpace(photo))
                                        {
                                            <img alt="@listing.Title" class="w-full h-full object-cover" src="@photo" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-[#3f4944]">
                                                <span class="material-symbols-outlined">styler</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <a href="/Listings/Details/@listing.Id" target="_blank" class="block font-bold text-[#00523d] group-hover:underline underline-offset-4 truncate">@listing.Title</a>
                                        <span class="block text-xs text-[#3f4944] truncate">@(listing.OwnerUser?.FullName ?? listing.OwnerUser?.UserName ?? "Kullanıcı")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-5"><span class="bg-[#00523d]/5 text-[#00523d] px-3 py-1 rounded-full text-xs font-bold border border-[#00523d]/10">@listing.Category</span></td>
                            <td class="px-6 py-5">
                                <span class="@StatusBadgeClass(listing.Status) px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1">
                                    @if (listing.Status == ListingStatus.Active)
                                    {
                                        <span class="w-2 h-2 rounded-full bg-current animate-pulse"></span>
                                    }
                                    else if (listing.Status == ListingStatus.Suspended)
                                    {
                                        <span class="material-symbols-outlined text-[14px]">error</span>
                                    }
                                    @listing.Status.ToDisplayText()
                                </span>
                            </td>
                            <td class="px-6 py-5 text-[#3f4944]">@listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="px-6 py-5">
                                <div class="flex items-center justify-end gap-2 flex-wrap">
                                    <form action="/Admin/ModerateListing" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@listing.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        @if (listing.Status == ListingStatus.Active)
                                        {
                                            <input type="hidden" name="status" value="@ListingStatus.Suspended" />
                                            <button class="bg-[#ba1a1a]/10 text-[#ba1a1a] hover:bg-[#ba1a1a] hover:text-white px-3 py-2 rounded-lg text-xs font-bold transition-all border border-[#ba1a1a]/20" type="submit">Askıya Al</button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="status" value="@ListingStatus.Active" />
                                            <button class="bg-[#006c4b]/10 text-[#006c4b] hover:bg-[#006c4b] hover:text-white px-3 py-2 rounded-lg text-xs font-bold transition-all border border-[#006c4b]/20" type="submit">Aktife Al</button>
                                        }
                                    </form>
                                    <a href="/Listings/Edit/@listing.Id" class="bg-[#e4e2dd] text-[#3f4944] hover:bg-[#3f4944] hover:text-white px-3 py-2 rounded-lg text-xs font-bold transition-all no-underline">Düzenle</a>
                                    <a href="/Listings/Details/@listing.Id" target="_blank" class="text-[#00523d] hover:bg-[#00523d]/10 p-2 rounded-lg transition-all" aria-label="İlanı görüntüle">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="px-6 py-4 bg-[#f5f3ed] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-t border-[#bec9c2]/40">
            <p class="text-xs font-medium text-[#3f4944]">Toplam @totalCount sonuçtan @firstResult-@lastResult arası gösteriliyor</p>
            <div class="flex gap-1 items-center">
                <a class="p-2 rounded-lg text-[#00523d] transition-all no-underline @(page <= 1 ? "opacity-40 pointer-events-none" : "hover:bg-[#00523d]/10")" href="@Url.Action("Listings", new { search, category = selectedCategory, status = selectedStatus, createdDate, page = page - 1 })">
                    <span class="material-symbols-outlined">chevron_left</span>
                </a>
                @for (var i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                {
                    <a class="w-9 h-9 rounded-lg font-bold text-xs flex items-center justify-center no-underline @(i == page ? "bg-[#00523d] text-white" : "text-[#1b1c18] hover:bg-[#00523d]/10")" href="@Url.Action("Listings", new { search, category = selectedCategory, status = selectedStatus, createdDate, page = i })">@i</a>
                }
                <a class="p-2 rounded-lg text-[#00523d] transition-all no-underline @(page >= totalPages ? "opacity-40 pointer-events-none" : "hover:bg-[#00523d]/10")" href="@Url.Action("Listings", new { search, category = selectedCategory, status = selectedStatus, createdDate, page = page + 1 })">
                    <span class="material-symbols-outlined">chevron_right</span>
                </a>
            </div>
        </div>
    </section>
</div>
