@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
    var isDashboard = path == "/admin" || path == "/admin/index";
    var isUsers = path.StartsWith("/admin/users");
    var isListings = path.StartsWith("/admin/listings");
    var isContainers = path.StartsWith("/admin/containers");
    var isAppointments = path.StartsWith("/admin/appointments");
    var isReports = path.StartsWith("/admin/reports");
    var adminName = User?.Identity?.Name ?? "Belediye Yetkilisi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Belediye Paneli</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true" />
    <style>
        body { font-family: "Manrope", sans-serif; background: linear-gradient(180deg,#f4f0e5 0%,#ece9dd 100%); color:#18261f; }
        .material-symbols-outlined { font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
        .ay-admin-shell { background: rgba(255,253,248,.84); border-right: 1px solid rgba(24,38,31,.08); }
        .ay-admin-link { border-radius: 16px; }
        .ay-admin-link.active { background: linear-gradient(135deg,#0f6b53,#1f8a63); color:white; }
    </style>
</head>
<body>
    <div class="flex min-h-screen">
        <aside class="hidden md:flex fixed left-0 top-0 h-screen z-40 w-64 flex-col p-4 gap-3 ay-admin-shell backdrop-blur-xl">
            <div class="rounded-[24px] bg-white/82 border border-black/5 p-4">
                <div class="text-[11px] uppercase tracking-[0.24em] text-slate-500 mb-2">Ayancık Belediyesi</div>
                <div class="font-headline text-[1.75rem] font-bold tracking-tight leading-tight">Kıyafet Operasyon Paneli</div>
            </div>
            <nav class="flex-1 flex flex-col gap-2">
                <a class="ay-admin-link @(isDashboard ? "active" : "bg-white/72 text-slate-700") flex items-center gap-3 px-4 py-3 no-underline" href="/Admin">
                    <span class="material-symbols-outlined">dashboard</span><span class="font-bold text-sm">Panel</span>
                </a>
                <a class="ay-admin-link @(isListings ? "active" : "bg-white/72 text-slate-700") flex items-center gap-3 px-4 py-3 no-underline" href="/Admin/Listings">
                    <span class="material-symbols-outlined">styler</span><span class="font-bold text-sm">İlan Yönetimi</span>
                </a>
                <a class="ay-admin-link @(isContainers ? "active" : "bg-white/72 text-slate-700") flex items-center gap-3 px-4 py-3 no-underline" href="/Admin/Containers">
                    <span class="material-symbols-outlined">map</span><span class="font-bold text-sm">Konteyner Haritası</span>
                </a>
                <a class="ay-admin-link @(isAppointments ? "active" : "bg-white/72 text-slate-700") flex items-center gap-3 px-4 py-3 no-underline" href="/Admin/Appointments">
                    <span class="material-symbols-outlined">event_available</span><span class="font-bold text-sm">Randevular</span>
                </a>
                <a class="ay-admin-link @(isUsers ? "active" : "bg-white/72 text-slate-700") flex items-center gap-3 px-4 py-3 no-underline" href="/Admin/Users">
                    <span class="material-symbols-outlined">group</span><span class="font-bold text-sm">Kullanıcılar</span>
                </a>
                <a class="ay-admin-link @(isReports ? "active" : "bg-white/72 text-slate-700") flex items-center gap-3 px-4 py-3 no-underline" href="/Admin/Reports">
                    <span class="material-symbols-outlined">report</span><span class="font-bold text-sm">Şikayetler</span>
                </a>
            </nav>
            <div class="rounded-[22px] bg-white/82 border border-black/5 p-4">
                <div class="text-sm text-slate-500">Oturum</div>
                <div class="font-bold mb-3 break-all">@adminName</div>
                <div class="grid grid-cols-1 gap-2">
                    <a href="/" class="rounded-2xl border border-black/10 px-3 py-2 text-center no-underline text-slate-700 font-bold bg-white">Site</a>
                    <form action="/Account/Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full rounded-2xl bg-black text-white px-3 py-2 font-bold">Çıkış</button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="flex-1 md:ml-64">
            <div class="pt-4 pb-5 px-4 md:px-6">
                <div class="max-w-7xl mx-auto">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="mb-4 rounded-4 bg-white border p-3 shadow-sm">@successMessage</div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="mb-4 rounded-4 bg-white border p-3 shadow-sm text-danger">@errorMessage</div>
                    }
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
