@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ayancık Belediyesi Kıyafet Dayanışma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArtaniPaylas.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    <style>
        :root {
            --public-bg: #f6f3eb;
            --public-paper: rgba(255,255,255,.88);
            --public-ink: #17231c;
            --public-muted: #617168;
            --public-border: #d7dcd1;
            --public-brand: #106a52;
            --public-brand-2: #1f8a63;
            --public-accent: #c7893c;
        }

        body.ap-layout-body {
            margin: 0;
            min-height: 100vh;
            font-family: "Manrope", sans-serif;
            color: var(--public-ink);
            background:
                radial-gradient(580px 220px at 0% 0%, rgba(199, 137, 60, 0.10), transparent 72%),
                radial-gradient(720px 260px at 100% 0%, rgba(16, 106, 82, 0.10), transparent 72%),
                linear-gradient(180deg, #fbf8f2 0%, #f1eee4 100%);
        }

        .ap-public-nav {
            backdrop-filter: blur(14px);
            background: rgba(255, 253, 248, 0.82);
            border-bottom: 1px solid rgba(23, 35, 28, 0.08);
        }

        .ap-public-shell {
            width: min(1280px, calc(100% - 32px));
        }

        .ap-public-brand {
            font-family: "Space Grotesk", sans-serif;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--public-ink);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
        }

        .ap-public-brand:hover {
            color: var(--public-brand);
        }

        .ap-public-brand-dot {
            width: 14px;
            height: 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--public-brand), var(--public-accent));
            box-shadow: 0 0 0 5px rgba(16, 106, 82, 0.08);
        }

        .ap-public-link {
            color: #33483e;
            font-weight: 700;
            text-decoration: none;
            border-radius: 999px;
            padding: 0.55rem 0.95rem;
            transition: background-color .18s ease, color .18s ease, border-color .18s ease;
        }

        .ap-public-link:hover,
        .ap-public-link.active {
            color: white;
            background: linear-gradient(135deg, var(--public-brand), var(--public-brand-2));
        }

        .ap-public-link:focus,
        .ap-public-link:focus-visible,
        .ap-public-brand:focus,
        .ap-public-brand:focus-visible,
        .ap-auth-link:focus,
        .ap-auth-link:focus-visible,
        .ap-auth-pill:focus,
        .ap-auth-pill:focus-visible {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(16, 106, 82, 0.16);
        }

        .ap-public-main {
            width: min(1280px, calc(100% - 32px));
        }

        .ap-public-flash {
            border-radius: 22px;
            border: 1px solid rgba(23, 35, 28, 0.08);
            box-shadow: 0 12px 28px rgba(23, 35, 28, 0.06);
        }

        .ap-public-footer {
            margin-top: auto;
            border-top: 1px solid rgba(23, 35, 28, 0.08);
            background: rgba(255, 253, 248, 0.58);
        }
    </style>
</head>
<body class="ap-layout-body d-flex flex-column min-vh-100" data-authenticated="@(isAuthenticated ? "true" : "false")">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg ap-public-nav">
            <div class="container-xxl ap-public-shell">
                <a class="ap-public-brand" asp-controller="Home" asp-action="Index">
                    <span class="ap-public-brand-dot"></span>
                    <span>Ayancık Kıyafet Dayanışma</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menü">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="ap-public-link @(path == "/" || path.StartsWith("/home") ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="ap-public-link @(path.StartsWith("/listings") ? "active" : string.Empty)" asp-controller="Home" asp-action="Index" asp-fragment="listings">İlanlar</a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="ap-public-link @(path.StartsWith("/requests/outgoing") ? "active" : string.Empty)" asp-controller="Requests" asp-action="Outgoing">Randevularım</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-lg-3 ap-auth-area">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xxl ap-public-main py-4 pb-5 d-flex flex-column flex-grow-1">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success ap-public-flash" role="alert">
                <strong>Başarılı:</strong> @successMessage
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger ap-public-flash" role="alert">
                <strong>Uyarı:</strong> @errorMessage
            </div>
        }

        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="ap-public-footer">
        <div class="container-xxl ap-public-shell py-4 d-flex flex-column flex-lg-row justify-content-between gap-3">
            <div>Ayancık Belediyesi kıyafet ilanları, konteynerler ve randevu süreci.</div>
            <div class="d-flex gap-3">
                <a asp-controller="Home" asp-action="Index" asp-fragment="listings" class="text-decoration-none text-muted">İlanlar</a>
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Bilgilendirme</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
