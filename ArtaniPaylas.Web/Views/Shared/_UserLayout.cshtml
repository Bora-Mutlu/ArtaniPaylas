@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
    var isDashboard = path == "/userdashboard" || path == "/userdashboard/index";
    var isAllListings = path == "/listings" || path.StartsWith("/listings/index") || path.StartsWith("/listings/details");
    var isOutgoing = path.StartsWith("/requests/outgoing") || path.StartsWith("/reviews/create");
    var isProfile = path.StartsWith("/profile");

    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserEmail = currentUser?.Email ?? string.Empty;
    var displayName = currentUser?.FullName ?? currentUser?.UserName ?? "Kullanıcı";
    var profileInitial = displayName.Trim()[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kullanıcı Paneli</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-panel.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: "#0f6b53",
                        ink: "#18261f",
                        paper: "#fffdf8",
                        sand: "#f2ede2",
                        line: "#d7dcd1"
                    },
                    fontFamily: {
                        body: ["Manrope", "sans-serif"],
                        headline: ["Space Grotesk", "sans-serif"]
                    }
                }
            }
        };
    </script>
    <style>
        :root{
            --ay-user-primary:#0f6b53;
            --ay-user-primary-2:#2a8d66;
            --ay-user-accent:#c58a42;
            --ay-user-bg:#f6f2e8;
            --ay-user-surface:#fffdf8;
            --ay-user-line:#d9d8cf;
            --ay-user-text:#1b2922;
            --ay-user-muted:#627066;
        }

        body { font-family: "Manrope", sans-serif; background: linear-gradient(180deg,#faf8f2 0%,#f1eee4 100%); color:var(--ay-user-text); }
        .material-symbols-outlined { font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
        .ay-user-shell { background: rgba(255,253,248,.76); border: 1px solid rgba(24,38,31,.08); }
        .ay-user-nav-link { border-radius: 18px; }
        .ay-user-nav-link.active { background: linear-gradient(135deg,var(--ay-user-primary),var(--ay-user-primary-2)); color: white; }
    </style>
</head>
<body class="overflow-x-hidden">
    <div class="flex min-h-screen">
        <aside class="hidden md:flex h-screen w-72 fixed left-0 top-0 flex-col p-5 gap-4 z-50 ay-user-shell backdrop-blur-xl">
            <a href="/" class="flex items-center gap-3 text-ink no-underline">
                <div class="h-11 w-11 rounded-2xl ay-icon-soft flex items-center justify-center">
                    <span class="material-symbols-outlined">apartment</span>
                </div>
                <div>
                    <h1 class="font-headline text-lg font-bold tracking-tight mb-0">Ayancık Paneli</h1>
                    <p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 mb-0">Randevu kullanıcısı</p>
                </div>
            </a>

            <div class="rounded-[24px] bg-white/80 border border-line p-4">
                <div class="flex items-center gap-3">
                <div class="h-12 w-12 rounded-full text-white flex items-center justify-center font-black" style="background:linear-gradient(135deg,var(--ay-user-primary),var(--ay-user-primary-2));">@profileInitial</div>
                    <div>
                        <div class="font-bold">@displayName</div>
                        <div class="text-sm ay-meta-note">@currentUserEmail</div>
                    </div>
                </div>
            </div>

            <nav class="flex-1 flex flex-col gap-2">
                <a class="ay-user-nav-link @(isDashboard ? "active" : "bg-white/70 ay-meta-note") flex items-center gap-3 px-4 py-3 no-underline" href="/UserDashboard">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span class="text-sm font-bold">Panelim</span>
                </a>
                <a class="ay-user-nav-link @(isAllListings ? "active" : "bg-white/70 ay-meta-note") flex items-center gap-3 px-4 py-3 no-underline" href="/Listings">
                    <span class="material-symbols-outlined">styler</span>
                    <span class="text-sm font-bold">Belediye İlanları</span>
                </a>
                <a class="ay-user-nav-link @(isOutgoing ? "active" : "bg-white/70 ay-meta-note") flex items-center gap-3 px-4 py-3 no-underline" href="/Requests/Outgoing">
                    <span class="material-symbols-outlined">event</span>
                    <span class="text-sm font-bold">Randevularım</span>
                </a>
                <a class="ay-user-nav-link @(isProfile ? "active" : "bg-white/70 ay-meta-note") flex items-center gap-3 px-4 py-3 no-underline" href="/Profile">
                    <span class="material-symbols-outlined">person</span>
                    <span class="text-sm font-bold">Profilim</span>
                </a>
            </nav>

            <div class="border-t border-line pt-4">
                <form action="/Account/Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full rounded-2xl bg-white/80 border border-line px-4 py-3 text-left font-bold text-slate-700">Çıkış Yap</button>
                </form>
            </div>
        </aside>

        <main class="flex-1 md:ml-72 min-h-screen">
            <header class="sticky top-0 z-40 px-4 md:px-8 py-4 backdrop-blur-xl" style="background:rgba(250,248,242,.78);border-bottom:1px solid rgba(24,38,31,.08);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small ay-meta-note">Ayancık Belediyesi koordinasyon sistemi</div>
                        <div class="fw-bold">@ViewData["Title"]</div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/Listings" class="btn ap-btn-outline">İlanlar</a>
                        <a href="/Requests/Outgoing" class="btn ap-btn-primary">Randevularım</a>
                    </div>
                </div>
            </header>

            <div class="p-4 p-md-5">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="mb-4 rounded-4 bg-white border p-3 shadow-sm"><strong>Başarılı:</strong> @successMessage</div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="mb-4 rounded-4 bg-white border p-3 shadow-sm text-danger"><strong>Uyarı:</strong> @errorMessage</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
