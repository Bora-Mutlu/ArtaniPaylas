@model ListingCreateEditViewModel
@{
    ViewData["Title"] = "İlan Düzenle";
    Layout = "_AdminLayout";
    var existingPhotos = Model.ExistingPhotos.Any()
        ? Model.ExistingPhotos
        : Model.ExistingPhotoPaths.Select(path => new ExistingListingPhotoViewModel { PhotoPath = path }).ToList();
    var photoCount = existingPhotos.Count;
}

<style>
    .listing-edit-page {
        --surface: #fbf9f3;
        --surface-low: #f5f3ed;
        --surface-container: #f0eee8;
        --surface-highest: #e4e2dd;
        --primary: #00523d;
        --primary-container: #0d6c52;
        --secondary: #006c4b;
        --secondary-container: #91f3c5;
        --on-surface: #1b1c18;
        --on-surface-variant: #3f4944;
        --outline-variant: #bec9c2;
        --error: #ba1a1a;
        color: var(--on-surface);
    }

    .listing-edit-page .soft-shadow {
        box-shadow: 0 10px 30px rgba(13, 108, 82, 0.04);
    }

    .listing-edit-page .form-input {
        width: 100%;
        min-height: 52px;
        border-radius: 0.75rem;
        border: 1px solid rgba(190, 201, 194, 0.6);
        background: var(--surface-low);
        color: var(--on-surface);
        padding: 0.75rem 1.5rem;
        transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
    }

    .listing-edit-page textarea.form-input {
        min-height: 132px;
        resize: vertical;
    }

    .listing-edit-page .form-input:focus {
        border-color: var(--primary);
        background: #fffefa;
        box-shadow: 0 0 0 3px rgba(0, 82, 61, 0.14);
        outline: none;
    }

    .listing-edit-page .field-validation-error,
    .listing-edit-page .validation-summary-errors {
        color: var(--error);
        font-size: 0.875rem;
        font-weight: 600;
    }

    .listing-edit-page .photo-tile {
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 1rem;
        background: var(--surface-container);
    }

    .listing-edit-page .photo-tile img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .listing-edit-page .photo-tile.is-marked-delete {
        opacity: 0.38;
    }

    .listing-edit-page .photo-tile.is-marked-delete::after {
        content: "Kaldırılacak";
        position: absolute;
        inset: auto 0 0 0;
        background: rgba(186, 26, 26, 0.9);
        color: #fff;
        padding: 0.35rem;
        text-align: center;
        font-size: 0.75rem;
        font-weight: 700;
    }
</style>

<main class="listing-edit-page pb-20">
    <div class="mb-12 flex flex-col gap-12 md:flex-row md:items-end md:justify-between">
        <div class="space-y-2">
            <a asp-controller="Admin" asp-action="Listings" class="flex items-center gap-1 text-sm font-bold uppercase tracking-[0.05em] text-[#00523d] no-underline hover:underline">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                İlan Yönetimine Dön
            </a>
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="mb-0 font-['Space_Grotesk'] text-[28px] font-semibold leading-9 text-[#1b1c18] md:text-[32px] md:leading-10">İlan Düzenle</h1>
                <span class="rounded-full bg-[#91f3c5] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#00714e]">Düzenleme Modu</span>
                <span class="rounded-full bg-[#e4e2dd] px-3 py-1 text-xs font-bold text-[#3f4944]">ID: @(Model.Id?.ToString() ?? "-")</span>
            </div>
            <p class="mb-0 max-w-2xl text-base leading-6 text-[#3f4944]">Yayınlanan ilanın içerik, tarih, konum ve görsel bilgilerini güncelle. Değişiklikler kaydedildikten sonra yayına yansır.</p>
        </div>

        <div class="flex flex-wrap items-center gap-6">
            <a asp-controller="Admin" asp-action="Listings" class="rounded-xl border border-[#00523d] px-6 py-3 text-sm font-bold uppercase tracking-[0.05em] text-[#00523d] no-underline transition hover:bg-[#00523d]/5">Vazgeç</a>
            <button form="edit-listing-form" type="submit" class="flex items-center gap-3 rounded-xl bg-[#00523d] px-12 py-3 text-sm font-bold uppercase tracking-[0.05em] text-white soft-shadow transition hover:bg-[#00523d]/90">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Değişiklikleri Kaydet
            </button>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="edit-listing-form" class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="space-y-12 lg:col-span-8">
            <div class="rounded-[32px] border border-white/40 bg-white p-6 soft-shadow md:p-12">
                <div class="mb-12 flex items-center justify-between border-b border-[#bec9c2] pb-6">
                    <h2 class="mb-0 font-['Space_Grotesk'] text-2xl font-semibold leading-8 text-[#1b1c18]">İlan Formu</h2>
                    <span class="flex items-center gap-1 text-sm font-bold uppercase tracking-[0.05em] text-[#006c4b]">
                        <span class="h-2 w-2 animate-pulse rounded-full bg-[#006c4b]"></span>
                        Canlı İlan
                    </span>
                </div>

                <div asp-validation-summary="ModelOnly" class="mb-6 rounded-2xl bg-[#ffdad6] p-4"></div>

                <div class="space-y-12">
                    <section class="space-y-6">
                        <div class="flex items-center gap-3 text-[#00523d]">
                            <span class="material-symbols-outlined">info</span>
                            <h3 class="mb-0 text-sm font-bold uppercase tracking-widest">Temel Bilgiler</h3>
                        </div>
                        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                            <div class="space-y-1 md:col-span-2">
                                <label asp-for="Title" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">İlan Başlığı</label>
                                <input asp-for="Title" class="form-input" />
                                <span asp-validation-for="Title"></span>
                            </div>
                            <div class="space-y-1">
                                <label asp-for="Category" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Kategori</label>
                                <select asp-for="Category" class="form-input">
                                    <option>Genel Giyim</option>
                                    <option>Çocuk Giyim</option>
                                    <option>Yetişkin Giyim</option>
                                    <option>Bebek Giyimi</option>
                                    <option>Mont</option>
                                    <option>Kazak</option>
                                    <option>Tişört</option>
                                    <option>Pantolon</option>
                                    <option>Ayakkabı</option>
                                    <option>Aksesuar</option>
                                    <option>Ev Tekstili</option>
                                </select>
                                <span asp-validation-for="Category"></span>
                            </div>
                            <div class="space-y-1">
                                <label asp-for="Size" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Beden / Ölçü</label>
                                <input asp-for="Size" class="form-input" placeholder="Örn: 8-10 Yaş, M, 38" />
                                <span asp-validation-for="Size"></span>
                            </div>
                            <div class="space-y-1">
                                <label asp-for="AgeGroup" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Yaş Grubu</label>
                                <select asp-for="AgeGroup" class="form-input">
                                    <option value="">Seçiniz</option>
                                    <option>Bebek</option>
                                    <option>Çocuk</option>
                                    <option>Genç</option>
                                    <option>Yetişkin</option>
                                </select>
                                <span asp-validation-for="AgeGroup"></span>
                            </div>
                            <div class="space-y-1">
                                <label asp-for="Condition" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Durum</label>
                                <select asp-for="Condition" class="form-input">
                                    <option value="">Seçiniz</option>
                                    <option>Yeni Gibi</option>
                                    <option>İyi</option>
                                    <option>Orta</option>
                                    <option>Tamire İhtiyaç Var</option>
                                </select>
                                <span asp-validation-for="Condition"></span>
                            </div>
                        </div>
                    </section>

                    <section class="space-y-6">
                        <div class="flex items-center gap-3 text-[#00523d]">
                            <span class="material-symbols-outlined">location_on</span>
                            <h3 class="mb-0 text-sm font-bold uppercase tracking-widest">Konum ve Tarih</h3>
                        </div>
                        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                            <div class="space-y-1">
                                <label asp-for="District" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">İlçe / Mahalle</label>
                                <input asp-for="District" class="form-input" placeholder="Örn: Ayancık Merkez" />
                                <span asp-validation-for="District"></span>
                            </div>
                            <div class="space-y-1">
                                <label asp-for="ExpirationDate" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">İlan Bitiş Tarihi</label>
                                <input asp-for="ExpirationDate" class="form-input" type="date" />
                                <span asp-validation-for="ExpirationDate"></span>
                            </div>
                            <div class="space-y-1 md:col-span-2">
                                <label asp-for="Location" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Detaylı Adres / Konum</label>
                                <input asp-for="Location" class="form-input" placeholder="Örn: Belediye Meydanı karşısı" />
                                <span asp-validation-for="Location"></span>
                            </div>
                        </div>
                    </section>

                    <section class="space-y-6">
                        <div class="flex items-center gap-3 text-[#00523d]">
                            <span class="material-symbols-outlined">description</span>
                            <h3 class="mb-0 text-sm font-bold uppercase tracking-widest">Açıklama</h3>
                        </div>
                        <div class="space-y-1">
                            <textarea asp-for="Description" class="form-input" rows="5"></textarea>
                            <span asp-validation-for="Description"></span>
                        </div>
                    </section>

                    <section class="space-y-6">
                        <div class="flex items-center gap-3 text-[#00523d]">
                            <span class="material-symbols-outlined">contact_support</span>
                            <h3 class="mb-0 text-sm font-bold uppercase tracking-widest">Teslim ve Ek Bilgiler</h3>
                        </div>
                        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                            <div class="space-y-1">
                                <label asp-for="Gender" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Cinsiyet</label>
                                <select asp-for="Gender" class="form-input">
                                    <option value="">Seçiniz</option>
                                    <option>Kadın</option>
                                    <option>Erkek</option>
                                    <option>Unisex</option>
                                </select>
                                <span asp-validation-for="Gender"></span>
                            </div>
                            <div class="space-y-1">
                                <label asp-for="Photos" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Yeni Fotoğraf Yükle</label>
                                <input asp-for="Photos" id="fileInput" class="form-input" type="file" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                                <p class="mb-0 mt-2 text-xs font-medium text-[#3f4944]">Yeni seçimler kaydetmeden aşağıda önizlenir ve mevcut fotoğrafların üstüne eklenir.</p>
                                <span asp-validation-for="Photos"></span>
                            </div>
                            <div class="space-y-1 md:col-span-2">
                                <label asp-for="ContactNote" class="ml-1 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Teslim / İletişim Notu</label>
                                <textarea asp-for="ContactNote" class="form-input" rows="3" placeholder="Teslim saati, belediye notu veya ek bilgilendirme"></textarea>
                                <span asp-validation-for="ContactNote"></span>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <div class="space-y-12 lg:col-span-4">
            <section class="rounded-[32px] border border-white/40 bg-white p-6 soft-shadow">
                <h4 class="mb-6 font-['Space_Grotesk'] text-2xl font-semibold leading-8">Mevcut Durum</h4>
                <div class="space-y-6">
                    <div class="flex items-center justify-between rounded-2xl bg-[#f0eee8] p-3">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[#00523d]">photo_library</span>
                            <span>Mevcut Fotoğraf</span>
                        </div>
                        <span class="font-bold text-[#00523d]">@photoCount adet</span>
                    </div>
                    <label for="fileInput" class="block cursor-pointer rounded-2xl border-2 border-dashed border-[#bec9c2] p-6 text-center transition hover:border-[#00523d]">
                        <span class="material-symbols-outlined mb-2 text-3xl text-[#3f4944]">add_a_photo</span>
                        <p class="mb-0 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Yeni Yükleme</p>
                        <p class="mb-0 text-xs font-medium italic text-[#3f4944]/70">(Eklenerek kaydedilir)</p>
                    </label>
                </div>
            </section>

            <section class="rounded-[32px] border border-white/40 bg-white p-6 soft-shadow">
                <div class="mb-6 flex items-center justify-between">
                    <h4 class="mb-0 font-['Space_Grotesk'] text-2xl font-semibold leading-8">Fotoğraflar</h4>
                    <span class="text-sm font-bold uppercase tracking-[0.05em] text-[#00523d]">@photoCount / 6</span>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    @if (photoCount > 0)
                    {
                        foreach (var photo in existingPhotos)
                        {
                            <div class="photo-tile relative" data-existing-photo-id="@photo.Id">
                                <img src="@photo.PhotoPath" alt="Mevcut ilan fotoğrafı" />
                                <button type="button" class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#ba1a1a] text-white shadow" data-remove-existing="@photo.Id" aria-label="Fotoğrafı kaldır">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="photo-tile flex items-center justify-center text-[#bec9c2]">
                            <span class="material-symbols-outlined text-3xl">image</span>
                        </div>
                    }
                    <div class="photo-tile flex items-center justify-center text-[#bec9c2]">
                        <span class="material-symbols-outlined text-3xl">image</span>
                    </div>
                </div>
                <div id="deleted-photo-inputs"></div>
                <div class="mt-6">
                    <p class="mb-3 text-sm font-bold uppercase tracking-[0.05em] text-[#3f4944]">Yeni Seçilenler</p>
                    <div id="preview-grid" class="grid grid-cols-2 gap-3"></div>
                </div>
            </section>

            <section class="rounded-[32px] border border-white/40 bg-white p-6 soft-shadow">
                <h4 class="mb-6 font-['Space_Grotesk'] text-2xl font-semibold leading-8">Hızlı Kontrol</h4>
                <ul class="mb-0 space-y-3 ps-0" style="list-style:none;">
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-[#006c4b]" style="font-variation-settings:'FILL' 1;">check_circle</span>
                        <div>
                            <p class="mb-0 text-sm font-bold uppercase tracking-[0.05em] text-[#1b1c18]">Net İlan Başlığı</p>
                            <p class="mb-0 text-xs font-medium text-[#3f4944]">Kullanıcılar ararken kolayca bulabilir.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-[#006c4b]" style="font-variation-settings:'FILL' 1;">check_circle</span>
                        <div>
                            <p class="mb-0 text-sm font-bold uppercase tracking-[0.05em] text-[#1b1c18]">Spesifik Beden Bilgisi</p>
                            <p class="mb-0 text-xs font-medium text-[#3f4944]">Hatalı talepleri önlemek için önemlidir.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-[#006c4b]" style="font-variation-settings:'FILL' 1;">check_circle</span>
                        <div>
                            <p class="mb-0 text-sm font-bold uppercase tracking-[0.05em] text-[#1b1c18]">Konum Doğruluğu</p>
                            <p class="mb-0 text-xs font-medium text-[#3f4944]">Lojistik planlama için kritik bilgi.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-3 opacity-40">
                        <span class="material-symbols-outlined text-[#6f7a74]">radio_button_unchecked</span>
                        <div>
                            <p class="mb-0 text-sm font-bold uppercase tracking-[0.05em] text-[#1b1c18]">Detaylı Fotoğraflar</p>
                            <p class="mb-0 text-xs font-medium text-[#3f4944]">En az 4 farklı açıdan çekim önerilir.</p>
                        </div>
                    </li>
                </ul>
            </section>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const fileInput = document.getElementById("fileInput");
            const previewGrid = document.getElementById("preview-grid");
            const deletedPhotoInputs = document.getElementById("deleted-photo-inputs");
            const selectedFiles = [];
            const deletedPhotoIds = new Set();

            document.querySelectorAll(".listing-edit-page input, .listing-edit-page select, .listing-edit-page textarea").forEach((input) => {
                input.addEventListener("focus", () => input.closest(".space-y-1")?.classList.add("scale-[1.01]"));
                input.addEventListener("blur", () => input.closest(".space-y-1")?.classList.remove("scale-[1.01]"));
            });

            document.querySelectorAll("[data-remove-existing]").forEach((button) => {
                button.addEventListener("click", () => {
                    const id = button.getAttribute("data-remove-existing");
                    const tile = button.closest("[data-existing-photo-id]");
                    if (!id || !tile) {
                        return;
                    }

                    if (deletedPhotoIds.has(id)) {
                        deletedPhotoIds.delete(id);
                        tile.classList.remove("is-marked-delete");
                        button.innerHTML = '<span class="material-symbols-outlined text-[18px]">delete</span>';
                    } else {
                        deletedPhotoIds.add(id);
                        tile.classList.add("is-marked-delete");
                        button.innerHTML = '<span class="material-symbols-outlined text-[18px]">undo</span>';
                    }

                    syncDeletedPhotoInputs();
                });
            });

            if (fileInput && previewGrid) {
                fileInput.addEventListener("change", (event) => {
                    const target = event.target;
                    if (target instanceof HTMLInputElement && target.files) {
                        appendFiles(target.files);
                    }
                });
            }

            function appendFiles(files) {
                const incoming = Array.from(files).filter((file) => file.type.startsWith("image/"));
                incoming.forEach((file) => {
                    const duplicate = selectedFiles.some((existing) =>
                        existing.name === file.name &&
                        existing.size === file.size &&
                        existing.lastModified === file.lastModified);

                    if (!duplicate) {
                        selectedFiles.push(file);
                    }
                });

                syncInputFiles();
                renderPreviews();
            }

            function removeFile(file) {
                const index = selectedFiles.findIndex((item) =>
                    item.name === file.name &&
                    item.size === file.size &&
                    item.lastModified === file.lastModified);

                if (index === -1) {
                    return;
                }

                selectedFiles.splice(index, 1);
                syncInputFiles();
                renderPreviews();
            }

            function syncInputFiles() {
                if (!fileInput) {
                    return;
                }

                const dataTransfer = new DataTransfer();
                selectedFiles.forEach((file) => dataTransfer.items.add(file));
                fileInput.files = dataTransfer.files;
            }

            function syncDeletedPhotoInputs() {
                if (!deletedPhotoInputs) {
                    return;
                }

                deletedPhotoInputs.innerHTML = "";
                deletedPhotoIds.forEach((id) => {
                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = "DeletedPhotoIds";
                    input.value = id;
                    deletedPhotoInputs.appendChild(input);
                });
            }

            function renderPreviews() {
                if (!previewGrid) {
                    return;
                }

                previewGrid.innerHTML = "";
                selectedFiles.forEach((file) => {
                    const reader = new FileReader();
                    reader.onload = (loadEvent) => {
                        const result = loadEvent.target?.result;
                        if (typeof result !== "string") {
                            return;
                        }

                        const tile = document.createElement("div");
                        tile.className = "photo-tile relative";
                        tile.innerHTML = `
                            <img src="${result}" alt="${escapeHtml(file.name)}" />
                            <button type="button" class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#ba1a1a] text-white shadow" aria-label="Seçilen fotoğrafı kaldır">
                                <span class="material-symbols-outlined text-[18px]">close</span>
                            </button>
                        `;
                        tile.querySelector("button")?.addEventListener("click", () => removeFile(file));
                        previewGrid.appendChild(tile);
                    };
                    reader.readAsDataURL(file);
                });
            }

            function escapeHtml(value) {
                return value
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }
        })();
    </script>
}
