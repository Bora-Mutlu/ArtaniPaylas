@model ListingCreateEditViewModel
@{
    ViewData["Title"] = "İlan Düzenle";
    Layout = "_UserLayout";
}

<section class="ap-page-head">
    <div>
        <h1 class="ap-title">İlan Düzenle</h1>
        <p class="ap-subtitle">İlan bilgilerini güncelleyerek daha doğru eşleşmeler alabilirsin.</p>
    </div>
</section>

<div class="row g-4 align-items-start">
    <div class="col-12">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="ap-form-shell">
            <input type="hidden" asp-for="Id" />
            <div class="ap-form-grid">
                <div class="ap-form-section">
                    <p class="ap-form-section-title">İlan Detayları</p>
                    <partial name="_Form" model="Model" />
                </div>
            </div>

            <div class="mt-4 ap-form-actions">
                <button class="btn ap-btn-primary" type="submit">Değişiklikleri Kaydet</button>
                <a asp-action="MyListings" class="btn ap-btn-outline">İptal</a>
            </div>
        </form>
    </div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




