@model ListingCreateEditViewModel

<div class="ap-form-section">
    <div asp-validation-summary="ModelOnly" class="ap-auth-alert mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label ap-form-label">Başlık</label>
        <input asp-for="Title" class="form-control ap-form-input" placeholder="Örn: XL Beden Erkek Mont" />
        <div class="form-text">Kısa ve anlaşılır bir başlık, ilanının daha hızlı bulunmasını sağlar.</div>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label ap-form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control ap-form-input ap-no-resize" rows="5" placeholder="Kıyafet durumu, deformesi var mı, yaka/kol/beden ölçüsü vb. yazabilirsiniz."></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="ExpirationDate" class="form-label ap-form-label">İlan Son Tarihi</label>
            <input asp-for="ExpirationDate" class="form-control ap-form-input" type="date" />
            <div class="form-text">Bu tarihten sonra ilan pasife alınır.</div>
            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Location" class="form-label ap-form-label">Konum</label>
            <input asp-for="Location" class="form-control ap-form-input" placeholder="Örn: Üsküdar" />
            <div class="form-text">İlçe/semt bilgisi yazman eşleşmeyi iyileştirir.</div>
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <label asp-for="Photo" class="form-label ap-form-label">Fotoğraf</label>
        <input asp-for="Photo" class="form-control ap-form-input" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
        <small class="ap-form-help">En fazla 5 MB. Desteklenen formatlar: JPG, PNG, WEBP.</small>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoPath))
    {
        <div class="mt-3">
            <p class="mb-2 fw-semibold">Mevcut Fotoğraf</p>
            <img src="@Model.ExistingPhotoPath" alt="Mevcut fotoğraf" class="ap-upload-preview" />
        </div>
    }
</div>

