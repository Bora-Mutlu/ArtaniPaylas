@model IReadOnlyCollection<Listing>
@{
    var activeOnly = ViewBag.ActiveOnly as bool? == true;
    ViewData["Title"] = "Belediye İlanları";
    Layout = "_AdminLayout";
}

<section class="ap-page-head">
    <div>
        <h1 class="ap-title">@(activeOnly ? "Aktif Belediye İlanları" : "Belediye İlanları")</h1>
        <p class="ap-subtitle">Belediye tarafından yönetilen ilanları buradan takip edebilirsin.</p>
    </div>
    <div class="d-flex gap-2">
        @if (activeOnly)
        {
            <a asp-action="MyListings" class="btn ap-btn-outline">Tüm İlanlar</a>
        }
        else
        {
            <a asp-action="MyListings" asp-route-activeOnly="true" class="btn ap-btn-outline">Sadece Aktifler</a>
        }
        <a asp-action="Create" class="btn ap-btn-primary">+ Yeni İlan</a>
    </div>
</section>

@if (!Model.Any())
{
    <div class="ap-empty">Henüz belediye ilanı bulunmuyor.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            var coverPhoto = item.Photos.OrderBy(x => x.SortOrder).Select(x => x.PhotoPath).FirstOrDefault() ?? item.PhotoPath;
            var statusClass = item.Status switch
            {
                ListingStatus.Active => "ap-pill ap-pill-active",
                ListingStatus.Completed => "ap-pill ap-pill-completed",
                ListingStatus.Expired => "ap-pill ap-pill-danger",
                _ => "ap-pill ap-pill-pending"
            };

            <div class="col-md-6 col-xl-4">
                <article class="ap-card p-3 h-100 d-flex flex-column gap-3">
                    @if (!string.IsNullOrWhiteSpace(coverPhoto))
                    {
                        <img src="@coverPhoto" alt="@item.Title" class="w-100 rounded-3" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center rounded-3 bg-light text-muted" style="height: 200px;">Fotoğraf yok</div>
                    }

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="@statusClass">@item.Status.ToDisplayText()</span>
                        <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                    </div>

                    <div>
                        <h2 class="h5 mb-1">@item.Title</h2>
                        <div class="text-muted small">@item.Category • @(item.Size ?? "Beden yok")</div>
                        <div class="text-muted small">@(item.District ?? item.Location)</div>
                    </div>

                    <div class="d-flex gap-2 mt-auto">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm ap-btn-outline">Detay</a>
                        @if (item.Status == ListingStatus.Active)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm ap-btn-outline">Düzenle</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Düzenle</button>
                        }
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
